# =============================================================
# workflow-automation-platform — Configuration d'environnement
# Copier ce fichier vers .env et remplir les valeurs réelles
# cp .env.example .env
# =============================================================

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=workflow_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=workflow_db
POSTGRES_PORT=5432

# URL de connexion complète (utilisée par les services applicatifs)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_PORT=6379

# URL de connexion complète (utilisée par les workers Celery / queues)
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:${REDIS_PORT}/0

# ─────────────────────────────────────────
# MLflow Tracking Server
# ─────────────────────────────────────────
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# ─────────────────────────────────────────
# API Gateway
# ─────────────────────────────────────────
API_GATEWAY_PORT=8000
API_SECRET_KEY=changeme_super_secret_key_32chars_min
API_DEBUG=false

# ─────────────────────────────────────────
# Agent LLM Service
# ─────────────────────────────────────────
AGENT_LLM_PORT=8002

# Provider LLM : "ollama" (local) | "openai" (cloud)
LLM_PROVIDER=ollama

# Ollama (modèle local)
OLLAMA_PORT=11434
OLLAMA_MODEL=gemma:2b

# OpenAI (fallback cloud — laisser vide si non utilisé)
OPENAI_API_KEY=

# Paramètres LLM par défaut
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=1024

# MLflow — expérience dédiée aux inférences
MLFLOW_EXPERIMENT_NAME=agent-llm-inference

# ─────────────────────────────────────────
# Trigger Service
# ─────────────────────────────────────────
TRIGGER_SERVICE_PORT=8001

# ─────────────────────────────────────────
# Orchestrator Service
# ─────────────────────────────────────────
ORCHESTRATOR_CONCURRENCY=4

# ─────────────────────────────────────────
# Orchestrator Service
# ─────────────────────────────────────────
ORCHESTRATOR_PORT=8003
ORCHESTRATOR_CONCURRENCY=4
REDIS_EVENTS_QUEUE=workflow:events

# ─────────────────────────────────────────
# Général
# ─────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
